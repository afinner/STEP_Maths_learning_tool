---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { modulePath } from '../lib/base';
import { formatDate, isoDate } from '../lib/format';
import { includeDrafts, publishedModules } from '../lib/collections';

const modules = publishedModules(await getCollection('modules'), {
  includeDrafts: includeDrafts(),
});

const STEPS = [
  { index: '01', name: 'Hook', text: 'A short example where the belief gives a wrong answer.' },
  { index: '02', name: 'Explore', text: 'Sliders and plots that measure exactly where it fails.' },
  { index: '03', name: 'Why', text: 'The mathematics, argued properly.' },
  { index: '04', name: 'STEP', text: 'The question it was learned from, with a solution.' },
  { index: '05', name: 'Bank', text: 'More questions with the same mechanism.' },
];
---

<BaseLayout
  title="Rebuilding mathematical intuition tool"
  description="An interactive mathematical concept-learning tool for testing familiar rules and intuitions, visualising where they break down, and rebuilding a more precise understanding of why they work."
>
  <section class="hero">
    <p class="eyebrow">By Andrew Finnerty</p>
    <h1>Rebuilding mathematical intuition</h1>
    <p class="hero-text">
      Inspired by independently studying for STEP, this project grew out of encountering ideas for which my intuition was superficial. 
STEP problems often seemed designed to push beyond an informal understanding of a topic, 
exposing the point at which a shortcut or mental model stopped being reliable.

Each module takes one of those intuitive rules or shortcuts and explores it interactively: 
showing why it often works, uncovering the assumptions behind it, and attempting to visualise the quantity or condition that determines where it breaks down.

The aim is not simply to identify misconceptions or shortcuts that lack rigour, but to rebuild them into stronger intuition; 
so that they can be applied confidently when it works, and situations where it breaks down can be recognised
    </p>
  </section>

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading" class="how-heading">Every module, in the same five parts</h2>
    <ol class="how-steps">
      {
        STEPS.map((step) => (
          <li>
            <span class="how-index" aria-hidden="true">{step.index}</span>
            <span class="how-name">{step.name}</span>
            <span class="how-text">{step.text}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="modules-heading">
    <h2 id="modules-heading" class="visually-hidden">Modules</h2>
    <ul class="module-grid">
      {
        modules.map((entry, i) => (
          <li>
            <a class="module-card" href={modulePath(entry.id)}>
              <span class="module-card-index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="module-card-title">{entry.data.title}</span>
              <span class="module-card-claim">“{entry.data.claim}”</span>
              <span class="module-card-summary">{entry.data.summary}</span>
              <span class="module-card-meta">
                <span>{entry.data.context}</span>
                {entry.data.question ? <span>{entry.data.question.citation}</span> : null}
                <time datetime={isoDate(entry.data.added)}>{formatDate(entry.data.added)}</time>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
