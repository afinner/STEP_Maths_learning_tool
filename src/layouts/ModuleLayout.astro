---
import BaseLayout from './BaseLayout.astro';
import SectionHead from './SectionHead.astro';
import type { ModuleFrontmatter } from '../schema';
import type { Sections } from '../lib/sections';
import { formatDate, isoDate, renderMath } from '../lib/format';

interface Props {
  data: ModuleFrontmatter;
  sections: Sections;
  /** Fixtures render through this same template; they just say so. */
  isFixture?: boolean;
}

const { data, sections, isFixture = false } = Astro.props;
const { explain: Explain, question: Question, solution: Solution, bank: Bank } = sections;

/*
 * Five sections, in this order, for every module: Hook, Explore, Why, STEP,
 * Bank. The template owns the order — a module supplies the substance and
 * cannot rearrange it. The hook is the body of index.md; Explore is the widget;
 * the other three are markdown files beside it.
 */
const NAV = [
  { id: 'hook', index: '01', name: 'Hook' },
  { id: 'explore', index: '02', name: 'Explore' },
  { id: 'why', index: '03', name: 'Why' },
  { id: 'step', index: '04', name: 'STEP' },
  { id: 'bank', index: '05', name: 'Bank' },
];
---

<BaseLayout title={`${data.title} — Failure modes`} description={data.summary}>
  {
    isFixture && (
      <p class="fixture-banner">
        Fixture. This page exists to exercise the build pipeline and is excluded from the
        production site.
      </p>
    )
  }

  <article class="module">
    <header class="module-header">
      <p class="eyebrow">
        <span>{data.context}</span>
        <span aria-hidden="true">·</span>
        <time datetime={isoDate(data.added)}>{formatDate(data.added)}</time>
      </p>
      <h1>{data.title}</h1>
      <p class="module-summary">{data.summary}</p>
    </header>

    <nav class="section-nav" aria-label="Sections of this module">
      <ol>
        {
          NAV.map((item) => (
            <li>
              <a href={`#${item.id}`} data-section={item.id}>
                <span class="section-nav-index">{item.index}</span>
                {item.name}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <section class="section section-hook" id="hook" aria-labelledby="hook-name">
      <SectionHead id="hook" index="01" name="Hook" />
      <div class="prose hook-prose"><slot /></div>
      <blockquote class="claim">
        <span class="claim-label">The belief</span>
        <p>{data.claim}</p>
      </blockquote>
    </section>

    <section class="section section-explore" id="explore" aria-labelledby="explore-name">
      <SectionHead
        id="explore"
        index="02"
        name="Explore"
        lead="Move the controls and watch where the belief stops being true. Every number below is computed live."
      />
      <div class="decisive">
        <span class="decisive-label">The number that decides it</span>
        <span class="decisive-symbol" set:html={renderMath(data.decisiveQuantity.symbol)} />
        <span class="decisive-name">{data.decisiveQuantity.name}</span>
        <p class="decisive-description">{data.decisiveQuantity.description}</p>
      </div>
      <!--
        The island arrives through a slot rather than a prop: Astro resolves a
        hydrated component's script URL from the static imports of the file that
        renders it, so the route file has to be the one to import it.
      -->
      <slot name="widget" />
    </section>

    <section class="section section-why" id="why" aria-labelledby="why-name">
      <SectionHead id="why" index="03" name="Why" lead="The same result, argued properly." />
      <div class="prose">
        {Explain ? <Explain /> : <p class="missing">explain.md is missing.</p>}
      </div>
      <div class="callouts">
        <div class="callout callout-repair">
          <span class="callout-label">The repaired picture</span>
          <p>{data.repairedIntuition}</p>
        </div>
        <div class="callout callout-boundary">
          <span class="callout-label">When the move is fine</span>
          <p>{data.boundary}</p>
        </div>
      </div>
    </section>

    <section class="section section-step" id="step" aria-labelledby="step-name">
      <SectionHead
        id="step"
        index="04"
        name="STEP"
        lead="The question this failure mode was learned from, and a solution that uses what is above."
      />
      {
        data.question ? (
          <p class="citation">
            <span class="citation-name">{data.question.citation}</span>
            <span class="citation-note">
              The wording below is this site's own. The original, with {data.question.behind}, is
              <a href={data.question.link} rel="noopener" target="_blank">here</a>.
            </span>
          </p>
        ) : null
      }
      <div class="question">
        <div class="prose">
          {Question ? <Question /> : <p class="missing">question.md is missing.</p>}
        </div>
      </div>
      <details class="solution">
        <summary>
          <span class="summary-marker" aria-hidden="true"></span>
          Solution
        </summary>
        <div class="prose">
          {Solution ? <Solution /> : <p class="missing">solution.md is missing.</p>}
        </div>
      </details>
    </section>

    <section class="section section-bank" id="bank" aria-labelledby="bank-name">
      <SectionHead id="bank" index="05" name="Bank" lead="More of the same mechanism, to work at your own pace." />
      <div class="prose bank">
        {Bank ? <Bank /> : <p class="missing">bank.md is missing.</p>}
      </div>
      <p class="provenance">{data.provenance}</p>
    </section>
  </article>

  <script>
    // Progressive enhancement: the section nav highlights where the reader is.
    // Without JavaScript it is an ordinary list of anchors.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.section-nav a[data-section]'));
    const sections = links
      .map((link) => document.getElementById(link.dataset.section ?? ''))
      .filter((s): s is HTMLElement => s !== null);
    if (links.length && 'IntersectionObserver' in window) {
      const visible = new Map<string, number>();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) visible.set(entry.target.id, entry.intersectionRatio);
          let best: string | null = null;
          let ratio = 0;
          for (const [id, r] of visible) {
            if (r > ratio) {
              ratio = r;
              best = id;
            }
          }
          for (const link of links) link.classList.toggle('is-current', link.dataset.section === best);
        },
        { rootMargin: '-15% 0px -60% 0px', threshold: [0, 0.1, 0.25, 0.5] },
      );
      for (const section of sections) observer.observe(section);
    }
  </script>
</BaseLayout>
